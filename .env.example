# =============================================================================
# GATHER — environment variable index (TEMPLATE, contains no real values)
#
# Each app loads its OWN env file:
#   apps/api/.env   <- copy from apps/api/.env.example   (server-side, may hold secrets)
#   apps/web/.env   <- copy from apps/web/.env.example   (shipped to browsers, NO secrets)
#
# This root file is the overview of every variable planned for the project. Variables marked
# "later phase" are NOT read by any code yet. Never commit real .env files.
# =============================================================================

# --- apps/api (server only) --------------------------------------------------
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS
WEB_ORIGIN=http://localhost:5173

# Supabase (server). Use your NEW project's values (never a personal/existing project).
# The service-role key bypasses RLS: api ONLY, never web. Both are required in production; without
# them the API still starts locally but every authenticated route answers 503.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# later phase — Stripe test mode (server)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- apps/web (public: everything VITE_* is visible to every visitor) ----------
# Leave empty in dev (Vite proxies /api to the API). Set when the API is on another origin.
VITE_API_BASE_URL=

# Supabase (browser). The anon/publishable key is designed to be public. Without them the web app
# shows an "authentication unavailable" notice.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# later phase — Stripe publishable key (public by design)
# VITE_STRIPE_PUBLISHABLE_KEY=
