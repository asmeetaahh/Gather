# Copy to apps/web/.env for local development. Never commit the real file.
#
# WARNING: every VITE_* variable is bundled into the browser build and visible to everyone.
# Only public values belong here. Never add a service-role key or any secret.

# Leave empty in dev: Vite proxies /api to http://localhost:4000.
# Set to the API origin (e.g. https://api.example.com) when deployed on a separate origin.
VITE_API_BASE_URL=


# Supabase (your NEW project). PUBLIC values only: the project URL and the anon/publishable key.
# Without them the app shows an "authentication unavailable" notice.
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY=

# --- later phases (not read by any code yet) ---------------------------------
# VITE_STRIPE_PUBLISHABLE_KEY=
