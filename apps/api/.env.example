# Copy to apps/api/.env for local development. Never commit the real file.
# Loaded via `node --env-file-if-exists=.env` (see package.json scripts).

NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS
WEB_ORIGIN=http://localhost:5173

# --- Supabase (your NEW project — never a personal/existing one) -------------
# Required in production; optional locally (authenticated routes answer 503 without them).
SUPABASE_URL=
# SECRET. Server-only; bypasses RLS; must never reach the web app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST MODE ONLY — Phase 5) -------------------------------------
# Optional locally: without them checkout, the billing portal and webhooks answer 503 (plans and your own
# subscription still load). Set BOTH or neither. Only test-mode keys are accepted (sk_test_… / rk_test_…): a live
# key makes the API refuse to start. Both are SECRETS, server-side only; they must never reach the web app.
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint (whsec_…); for local development it comes from `stripe listen`.
STRIPE_WEBHOOK_SECRET=
