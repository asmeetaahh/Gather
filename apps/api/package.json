{
  "name": "@gather/api",
  "version": "0.0.0",
  "private": true,
  "description": "GATHER Express API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p ../../packages/shared/tsconfig.build.json && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "preflight:stripe": "tsx --env-file-if-exists=.env src/scripts/stripe-preflight.ts"
  },
  "dependencies": {
    "@gather/shared": "^0.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "light-my-request": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
